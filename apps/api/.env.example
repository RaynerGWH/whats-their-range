# Local SQLite requires no accounts. Use a Supabase session-pooler connection
# URL (postgresql+psycopg://...) for hosted persistence. Never expose it in React.
DATABASE_URL=sqlite:///./data/wtr.sqlite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
AGENT_DEADLINE_SECONDS=10
AGENT_MAX_CALLS=100
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=whats-their-range
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required when binding to a public interface. Enter in the dashboard once.
CONTROL_TOKEN=
WTR_PUBLIC=false
